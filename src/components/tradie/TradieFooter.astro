---
import { business, navItems, footerServices, socialLinks } from '../../data/tradieData';
---
<footer class="bg-slate-950 py-14 text-slate-400">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 sm:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-4">
      <div class="leading-tight">
        <span class="block text-base font-extrabold tracking-wide text-white">{business.logoPrimary}</span>
        <span class="block text-[11px] font-semibold uppercase tracking-[0.15em]">
          <span class="text-blue-400">{business.logoSecondaryFirst}</span>
          <span class="text-slate-600"> &amp; </span>
          <span class="text-orange-400">{business.logoSecondarySecond}</span>
        </span>
      </div>
      <p class="max-w-xs text-sm leading-6">
        Trusted plumbing and heating engineer providing high quality workmanship across Herefordshire and surrounding areas.
      </p>
      <div class="flex gap-3">
        {socialLinks.map((link) => (
          <a href={link.href} class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 text-slate-300 hover:bg-blue-500 hover:text-white" aria-label={link.label}>
            <span set:html={link.icon}></span>
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-3">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Quick Links</p>
      <div class="flex flex-col gap-2 text-sm">
        {navItems.map((item) => (
          <a href={`#${item.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-blue-400">{item}</a>
        ))}
      </div>
    </div>

    <div class="space-y-3">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Services</p>
      <div class="flex flex-col gap-2 text-sm">
        {footerServices.map((service) => (
          <span>{service}</span>
        ))}
      </div>
    </div>

    <div class="space-y-3">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-white">Contact</p>
      <a href={business.phoneHref} class="flex items-center gap-2 text-sm hover:text-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        {business.phone}
      </a>
      <a href={`mailto:${business.email}`} class="flex items-center gap-2 text-sm hover:text-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0"><path d="M22 6l-10 7L2 6"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
        {business.email}
      </a>
      <p class="flex items-start gap-2 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        Herefordshire — Covering all surrounding areas
      </p>
      <p class="pt-1 text-xs font-semibold uppercase tracking-wide text-amber-400">Gas Safe Registered</p>
    </div>
  </div>

  <div class="mx-auto mt-10 flex max-w-6xl flex-col gap-2 border-t border-white/10 px-6 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {business.name}. Example site — not a live business.</p>
    <p>
      Example website design &amp; build by <a href="/" class="font-semibold text-blue-400 hover:text-blue-300">Daniel McDermott</a>
    </p>
  </div>
</footer>
