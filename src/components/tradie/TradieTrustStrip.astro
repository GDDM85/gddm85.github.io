---
import { trustStrip } from '../../data/tradieData';
---
<section class="bg-white py-14">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 text-center sm:grid-cols-2 lg:grid-cols-4">
    {trustStrip.map((item) => (
      <div class="flex flex-col items-center gap-3">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-blue-500 text-blue-500">
          <span class="h-6 w-6" set:html={item.icon}></span>
        </span>
        <h3 class="text-sm font-semibold text-slate-900">{item.title}</h3>
        <p class="text-xs leading-5 text-slate-500">{item.description}</p>
      </div>
    ))}
  </div>
</section>
