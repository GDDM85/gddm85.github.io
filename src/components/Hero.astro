---
import Button from './Button.astro';
import profilePhoto from '../images/20231017_135440-removebg-preview.png';

const metadata = [
  { 
    label: 'UK Based',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>'
  },
  { 
    label: 'Leader & Mentor',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>'
  },
  { 
    label: 'Full-Stack Engineer',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline><polyline points="12 12 20 7.5"></polyline><polyline points="12 12 12 21"></polyline><polyline points="12 12 4 7.5"></polyline></svg>'
  }
];
---
<section id="home" class="relative overflow-hidden pb-20 pt-10 sm:pt-14">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(0,188,212,0.16),_transparent_25%)]" />
  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="text-sm uppercase tracking-[0.35em] text-cyan-200/80">Hi, I'm</p>
          <h1 class="text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">Daniel McDermott</h1>
          <p class="text-xl font-semibold text-cyan-300">Lead Developer. Systems Thinker. Problem Solver.</p>
          <p class="max-w-2xl text-slate-300 leading-8">
            I build and lead scalable software solutions as an engineering leader and full-stack developer, delivering meaningful impact at scale.
          </p>
        </div>

        <div class="flex flex-wrap gap-4">
          <Button href="#work">View My Work</Button>
          <Button href="#about" variant="secondary">About Me</Button>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          {metadata.map((item) => (
            <div class="inline-flex items-center gap-2 rounded-none bg-slate-800/20 px-4 py-3 text-sm text-cyan-300">
              <span class="inline-flex h-5 w-5 flex-shrink-0" set:html={item.icon}></span>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="relative w-full flex items-end justify-center">
        <div class="absolute -left-10 top-0 h-44 w-44 rounded-full bg-cyan-500/10 blur-3xl" />
        <div class="relative w-full">
          <img
            src={profilePhoto.src}
            alt="Daniel McDermott"
            class="relative z-10 w-full lg:w-[125%] lg:-ml-[12%] object-contain"
            style="filter: grayscale(100%) contrast(1.1) brightness(0.8); mask-image: linear-gradient(to bottom, black 55%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);"
          />
          <div class="absolute inset-0 bg-gradient-to-l from-transparent via-transparent to-slate-950/80 z-20 pointer-events-none" />
        </div>
      </div>
    </div>
  </div>
</section>
