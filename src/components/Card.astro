---
const { label = '', title = '', description = '', href = '', linkLabel = '', icon = '', details = [] } = Astro.props;
---
<div class="rounded-md border border-white/10 bg-slate-900/80 p-6 shadow-soft transition-colors duration-200 hover:border-cyan-400/20 hover:bg-slate-900/95">
  {icon && <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-500/10 text-cyan-200 text-lg">{icon}</div>}
  {label && <span class="inline-flex rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-cyan-200">{label}</span>}
  {title && <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>}
  {description && <p class="mt-4 text-slate-300 leading-7">{description}</p>}
  {details && details.length > 0 ? (
    <details class="group mt-6">
      <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-cyan-300 marker:hidden hover:text-cyan-100 [&::-webkit-details-marker]:hidden">
        <span>{linkLabel || 'View case study →'}</span>
        <span class="transition-transform duration-200 group-open:rotate-180" aria-hidden="true">⌄</span>
      </summary>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-300 leading-6">
        {details.map((point) => <li>{point}</li>)}
      </ul>
    </details>
  ) : (
    href && linkLabel && (
      <a href={href} class="mt-6 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-100">{linkLabel}</a>
    )
  )}
</div>
