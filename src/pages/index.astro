---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { whatIDoItems, featuredWork, thoughts, techStack } from '../data/siteData';
const meta = {
  title: 'Daniel McDermott — Lead Developer',
  description: 'Modern dark-theme profile for Daniel McDermott — engineering leader and full-stack developer building scalable software.',
};
---
<BaseLayout title={meta.title} description={meta.description}>
  <Header />
  <Hero />

  <Section id="what-i-do">
    <Container className="flex flex-col gap-6 lg:flex-row">
      <div class="lg:flex-shrink-0 lg:w-1/3 rounded-none bg-slate-800/30 p-8 flex flex-col">
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-200/80 mb-2">What I Do</p>
        <h2 class="text-2xl font-semibold text-white mb-4">Turning complexity into reliable solutions.</h2>
        <p class="text-slate-300 leading-8 flex-1">
          With a background spanning infrastructure to full-stack development, I combine deep technical knowledge with a pragmatic approach to deliver software that makes a real difference.
        </p>
        <Button href="#about" variant="secondary" className="mt-6">More about my journey →</Button>
      </div>
      <div class="grid grid-cols-2 gap-4 lg:flex lg:flex-1">
        {whatIDoItems.map((item) => (
          <div class="rounded-none bg-slate-800/30 p-6 flex flex-col">
            <div class="h-8 w-8 mb-3 text-cyan-300" set:html={item.icon}></div>
            <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
            <p class="text-sm text-slate-300 leading-6">{item.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="featured-work">
    <Container className="flex flex-col gap-6 lg:flex-row">
      <div class="lg:flex-shrink-0 lg:w-1/3 rounded-none bg-slate-800/30 p-8 flex flex-col">
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-200/80 mb-2">Featured Work</p>
        <h2 class="text-2xl font-semibold text-white mb-4">Solving meaningful problems at scale.</h2>
        <p class="text-slate-300 leading-8 flex-1">
          Projects where I've driven significant technical impact—from platform architecture to enabling teams with modern DevOps practices.
        </p>
        <Button href="#work" variant="secondary" className="mt-6">View all projects →</Button>
      </div>
      <div class="flex flex-1 gap-4 flex-col">
        {featuredWork.map((item) => (
          <Card label={item.label} title={item.title} description={item.description} href={item.href} linkLabel="View case study →" />
        ))}
      </div>
    </Container>
  </Section>

  <Section id="thoughts">
    <Container className="flex flex-col gap-6 lg:flex-row">
      <div class="lg:flex-shrink-0 lg:w-1/3 rounded-none bg-slate-800/30 p-8 flex flex-col">
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-200/80 mb-2">Thoughts</p>
        <h2 class="text-2xl font-semibold text-white mb-4">Sharing ideas and lessons learned.</h2>
        <p class="text-slate-300 leading-8 flex-1">
          Articles on engineering, leadership and building software that matters.
        </p>
        <Button href="#thoughts" variant="secondary" className="mt-6">Read all articles →</Button>
      </div>
      <div class="flex flex-1 gap-4 flex-col">
        {thoughts.map((item) => (
          <Card label={item.date} title={item.title} description={item.summary} href={item.href} linkLabel="Read article →" />
        ))}
      </div>
    </Container>
  </Section>

  <Section id="tech-stack">
    <Container className="space-y-6">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-200/80">Tech Stack</p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(3.5rem,1fr))] gap-4 items-center">
        {techStack.map((tech) => (
          <div class="h-12 w-12 mx-auto text-slate-300 hover:text-cyan-300 transition-colors" title={tech.name} set:html={tech.icon}></div>
        ))}
      </div>
    </Container>
  </Section>

  <Footer />
</BaseLayout>
