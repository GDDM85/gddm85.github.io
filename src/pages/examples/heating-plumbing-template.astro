---
import TradieLayout from '../../layouts/TradieLayout.astro';
import TradieHeader from '../../components/tradie/TradieHeader.astro';
import TradieHero from '../../components/tradie/TradieHero.astro';
import TradieTrustStrip from '../../components/tradie/TradieTrustStrip.astro';
import TradieAbout from '../../components/tradie/TradieAbout.astro';
import TradieServices from '../../components/tradie/TradieServices.astro';
import TradieGallery from '../../components/tradie/TradieGallery.astro';
import TradieTestimonials from '../../components/tradie/TradieTestimonials.astro';
import TradieAreasCovered from '../../components/tradie/TradieAreasCovered.astro';
import TradieContact from '../../components/tradie/TradieContact.astro';
import TradieFooter from '../../components/tradie/TradieFooter.astro';
import { business } from '../../data/tradieData';

const meta = {
  title: `${business.name} — Example Website Design`,
  description: `Example website mock-up for ${business.name}, a heating & plumbing business covering ${business.areaSummary}. Built as a portfolio demo by Daniel McDermott.`,
};
---
<TradieLayout title={meta.title} description={meta.description}>
  <TradieHeader />
  <TradieHero />
  <TradieTrustStrip />
  <TradieAbout />
  <TradieServices />
  <TradieGallery />
  <TradieTestimonials />
  <TradieAreasCovered />
  <TradieContact />
  <TradieFooter />
</TradieLayout>
